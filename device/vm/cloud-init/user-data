#cloud-config
# This project was developed with assistance from AI tools.
# Desktop stand-in device VM (D024). create-vm.sh substitutes __SSH_PUBKEY__.
# Nothing else runs here: provision.sh is run by hand after registration.
hostname: act-device
fqdn: act-device.localdomain
manage_etc_hosts: true
users:
  - name: jary
    groups: [wheel]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__
ssh_pwauth: false
disable_root: true
growpart:
  mode: auto
  devices: ["/"]
  ignore_growroot_disabled: false
resize_rootfs: true
