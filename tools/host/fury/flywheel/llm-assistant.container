# This project was developed with assistance from AI tools.
#
# Act 2's coding assistant: vLLM serving RedHatAI/Qwen3-Coder-Next-NVFP4 from the large MIG slice (0:0, 3g.126gb),
# OpenAI API with tool calling. A host service, as the plan's Phase 6 has it: fury-mode tenants starts it once the
# slices exist, any mode switch stops it first (MIG only changes while nothing holds the GPU). The flags are the
# ones measured in D154.
#
# Which build of vLLM serves is the Image= line and nothing else.
#
# Loopback only. There is no API key, and this machine has an uplink that is not ours: from a laptop use
#   ssh -N -L 8000:127.0.0.1:8000 <user>@<host>
# Opening it to a network is an operator's decision: --host 0.0.0.0 below plus a firewalld rule for that network only.
[Unit]
Description=Coding assistant (vLLM on MIG slice 0:0)
After=mig-config.service nvidia-cdi-refresh.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Container]
ContainerName=llm-assistant
Image=docker.io/vllm/vllm-openai@sha256:251eba5cc7c12fed0b75da22a9240e582b1c9e39f6fbc064f86781b963bd814f
Pull=never
Network=host
AddDevice=nvidia.com/gpu=0:0
ShmSize=4g
Volume=/data/models/RedHatAI/Qwen3-Coder-Next-NVFP4:/models/Qwen3-Coder-Next-NVFP4:ro,z
# compiled kernels and graphs: minutes of work at the first start, kept across containers
Volume=llm-cache.volume:/tmp
Environment=FLASHINFER_WORKSPACE_BASE=/tmp
Environment=VLLM_CACHE_ROOT=/tmp/vllm
Environment=TRITON_CACHE_DIR=/tmp/triton
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=VLLM_NO_USAGE_STATS=1
Environment=DO_NOT_TRACK=1
Environment=VLLM_HOST_IP=127.0.0.1
# an image may preload an allocator built for 4k pages; this kernel has 64k
Environment=LD_PRELOAD=
# this image's own entrypoint is `vllm serve`, which wants the model as a positional argument
Entrypoint=python3
Exec=-m vllm.entrypoints.openai.api_server --model /models/Qwen3-Coder-Next-NVFP4 --served-model-name qwen3-coder-next --host 127.0.0.1 --port 8000 --tensor-parallel-size 1 --max-model-len 131072 --gpu-memory-utilization 0.90 --max-num-seqs 8 --kv-cache-dtype auto --enable-auto-tool-choice --tool-call-parser qwen3_coder --linear-backend cutlass --gdn-prefill-backend triton --no-enable-flashinfer-autotune
# no curl in the image. A cold start took 5 min 46 s when measured; a first start on a new slice compiles more.
HealthCmd=["python3","-c","import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).status == 200 else 1)"]
HealthStartPeriod=20m
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthOnFailure=kill
StopTimeout=60

[Service]
# Not ExecStartPre=: a failed pre-start under Restart=always loops for ever. A condition that exits non-zero
# skips the start - the unit ends inactive, not failed, and is not restarted. So a boot in flywheel mode, or a
# start by mistake while MIG is off, does nothing at all.
ExecCondition=/bin/sh -c 'nvidia-ctk cdi list 2>/dev/null | tr -d "[:blank:]" | grep -qxF "nvidia.com/gpu=0:0" || { echo "CDI device nvidia.com/gpu=0:0 is not there (MIG off): not starting"; exit 1; }'
SuccessExitStatus=143
Restart=always
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=120

# a boot in tenants mode brings it back by itself; in flywheel mode the condition above skips it
[Install]
WantedBy=multi-user.target
