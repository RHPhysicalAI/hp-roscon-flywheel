# This project was developed with assistance from AI tools.
#
# Started by llm-assistant-proxy.socket on the first connection. With the assistant down (flywheel mode) the
# forward is refused and the caller sees a closed connection - nothing to manage across mode switches.
[Unit]
Description=Forward the hub-side listener to the coding assistant on loopback
Requires=llm-assistant-proxy.socket
After=llm-assistant-proxy.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=10min 127.0.0.1:8000
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
